<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- TOP HEADER: BRAND + LIVE STATUS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="-0.02"
            android:text="Claude Pulse"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● "
                android:textColor="#10B981"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextClock
                android:id="@+id/widget_live_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="hh:mm a"
                android:format24Hour="HH:mm"
                android:textColor="#10B981"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="07:05 PM" />
        </LinearLayout>
    </LinearLayout>

    <!-- DUAL TELEMETRY COCKPIT (SEAMLESS COLUMNS WITH VERTICAL DIVIDER) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- LEFT COLUMN: SHLOKSHAH412 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● shlokshah412"
                android:textColor="#00F2FE"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_acc1_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="--h --m Left"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"
                tools:text="2h 30m Left" />

            <TextView
                android:id="@+id/widget_acc1_reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Resets at --:--"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                tools:text="Resets at 08:32 PM" />

            <TextView
                android:id="@+id/widget_acc1_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/widget_badge_cyan"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:text="Status"
                android:textColor="#00F2FE"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="Expiring soon" />
        </LinearLayout>

        <!-- SUBTLE VERTICAL DIVIDER -->
        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginVertical="4dp"
            android:background="#26FFFFFF" />

        <!-- RIGHT COLUMN: PCGPT -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● pcgpt"
                android:textColor="#C084FC"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_acc2_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="--h --m Left"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"
                tools:text="4h 15m Left" />

            <TextView
                android:id="@+id/widget_acc2_reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Resets at --:--"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                tools:text="Resets at 10:36 PM" />

            <TextView
                android:id="@+id/widget_acc2_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/widget_badge_purple"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:text="Status"
                android:textColor="#C084FC"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="Fresh quota" />
        </LinearLayout>
    </LinearLayout>

    <!-- BOTTOM INTELLIGENCE PILL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_rec_bg"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/widget_advice_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Quick Tasks: [Account]   •   Deep Work: [Account]"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Quick Tasks: shlokshah412   •   Deep Work: pcgpt" />
    </LinearLayout>

</LinearLayout>
